  koreanFont: {fileID: 11400000, guid: 81c4f499ad74fa74b84100132192c588, type: 2}
  englishFont: {fileID: 11400000, guid: fee3f3492d46e774183c7900adf60948, type: 2}
  records:
  - day: 1
    recordType: "\uC815\uAE30 \uC6B4\uC601 \uAE30\uB85D"
    title: "\uD3C9\uC18C\uC640 \uB2E4\uB978 \uC2DC\uC791"
    body: "\uC815\uAE30 \uB9C8\uB825 \uBC94\uB78C\uAE30\uAC00 \uC2DC\uC791\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uD604\uC7AC
      \uB2E4\uC218\uC758 \uC9C0\uC5ED\uC5D0\uC11C \uC608\uCE21 \uBC94\uC704\uB97C
      \uCD08\uACFC\uD558\uB294 \uB9C8\uB825 \uBC18\uC751\uC774 \uAD00\uCE21\uB418\uACE0
      \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC81C17 \uC81C\uC5B4\uC18C\uC758 \uC2DC\uC124
      \uC0C1\uD0DC\uB294 \uC548\uC815\uC801\uC774\uB098, \uC774\uC0C1\uD604\uC0C1
      \uBC1C\uC0DD\uB7C9\uC774 \uD3C9\uB144\uBCF4\uB2E4 \uC99D\uAC00\uD560 \uAC83\uC73C\uB85C
      \uC608\uC0C1\uB429\uB2C8\uB2E4.\n\n\uC2DC\uC124 \uC548\uC815\uD654 \uC5C5\uBB34\uB97C
      \uAC1C\uC2DC\uD558\uC2ED\uC2DC\uC624."
    caution: "- \uC774\uC0C1\uD604\uC0C1\uC740 \uBC29\uCE58\uD560\uC218\uB85D \uC131\uC7A5\uD558\uACE0
      \uC704\uD5D8\uD574\uC9D1\uB2C8\uB2E4.\n- \uC2DC\uC124 \uC548\uC815\uB3C4\uAC00
      0\uC774 \uB418\uBA74 \uADFC\uBB34\uC5D0 \uC2E4\uD328\uD569\uB2C8\uB2E4.\n-
      \uB9C8\uB825 \uC624\uC5FC\uB3C4\uAC00 100\uC5D0 \uB3C4\uB2EC\uD558\uBA74 \uADFC\uBB34\uC5D0
      \uC2E4\uD328\uD569\uB2C8\uB2E4."
    handoffMemo: "\uC624\uB298 \uC815\uD654\uC2E4\uC5D0\uC11C \uBC18\uC751\uC774
      \uB450 \uBC88\uC774\uB098 \uB098\uC654\uC5B4. \uD3C9\uC18C \uAC19\uC73C\uBA74
      \uD558\uB8E8\uC5D0 \uD558\uB098 \uBCFC\uAE4C \uB9D0\uAE4C \uD558\uB294\uB370.\n\n\uB2E4\uB978
      \uC9C0\uC5ED\uB3C4 \uBE44\uC2B7\uD55C \uAC83 \uAC19\uB354\uB77C. \uC774\uBC88
      \uBC94\uB78C\uAE30\uB294 \uC880 \uC2DC\uB044\uB7FD\uACA0\uC5B4."
  - day: 2
    recordType: "\uC6B4\uC601 \uAE30\uB85D"
    title: "\uC99D\uAC00\uD558\uB294 \uBC1C\uC0DD\uB7C9"
    body: "\uC81C17 \uC81C\uC5B4\uC18C\uC758 \uC774\uC0C1\uD604\uC0C1 \uBC1C\uC0DD\uB7C9\uC774
      \uC608\uC0C1\uCE58\uB97C \uCD08\uACFC\uD588\uC2B5\uB2C8\uB2E4.\n\n\uC778\uC811
      \uC9C0\uC5ED\uC5D0\uC11C\uB3C4 \uC720\uC0AC\uD55C \uC99D\uAC00 \uCD94\uC138\uAC00
      \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uD604\uC7AC\uAE4C\uC9C0 \uBC94\uB78C
      \uAC15\uB3C4\uAC00 \uAC10\uC18C\uD560 \uC9D5\uD6C4\uB294 \uAD00\uCE21\uB418\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    caution: 
    handoffMemo: 
  - day: 3
    recordType: "\uC9C0\uC5ED \uB300\uC751 \uAE30\uB85D"
    title: "\uC9C0\uC6D0 \uC694\uCCAD \uC99D\uAC00"
    body: "\uAC01 \uC9C0\uC5ED \uC81C\uC5B4\uC18C\uC5D0\uC11C \uACE0\uC704\uD5D8
      \uC774\uC0C1\uD604\uC0C1 \uBC1C\uC0DD \uBCF4\uACE0\uAC00 \uC99D\uAC00\uD558\uACE0
      \uC788\uC2B5\uB2C8\uB2E4.\n\n\uAD00\uB9AC\uAD6D\uC740 \uC778\uAD6C \uBC00\uC9D1
      \uC9C0\uC5ED \uBC0F \uC8FC\uC694 \uC2DC\uC124\uC744 \uC911\uC2EC\uC73C\uB85C
      \uCD94\uAC00 \uC778\uB825\uC744 \uBC30\uCE58\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC81C17
      \uC81C\uC5B4\uC18C\uB294 \uD604\uD589 \uAD50\uB300 \uADFC\uBB34 \uCCB4\uACC4\uB97C
      \uC720\uC9C0\uD569\uB2C8\uB2E4."
    caution: 
    handoffMemo: "\uCD94\uAC00 \uC778\uB825\uC740 \uB2F9\uBD84\uAC04 \uC5B4\uB835\uB300.
      \uC2DC\uB0B4 \uCABD\uBD80\uD130 \uC9C0\uC6D0\uC774 \uB4E4\uC5B4\uAC04\uB2E4\uACE0
      \uD558\uB354\uB77C.\n\n\uADF8\uB7EC\uACE0\uBCF4\uB2C8 \uB9C8\uB825\uD575 \uC7A5\uCE58\uC758
      \uC0C1\uD0DC\uB3C4 \uD3C9\uC18C\uB791\uC740 \uB2E4\uB978 \uBC18\uC751\uC774
      \uC788\uB358\uB370 \uC870\uC2EC\uD574."
  - day: 4
    recordType: "\uC678\uACFD \uAD00\uCE21 \uAE30\uB85D"
    title: "\uC678\uACFD \uC9C0\uC5ED \uD655\uC0B0"
    body: "\uB9C8\uB825 \uBC94\uB78C\uC758 \uC601\uD5A5\uC774 \uC678\uACFD \uC9C0\uC5ED\uC73C\uB85C
      \uD655\uB300\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC81C17 \uC81C\uC5B4\uC18C\uC5D0\uC11C\uB3C4
      \uB192\uC740 \uB2E8\uACC4\uC758 \uC774\uC0C1\uD604\uC0C1 \uBC1C\uC0DD \uAC00\uB2A5\uC131\uC774
      \uC99D\uAC00\uD588\uC2B5\uB2C8\uB2E4.\n\n\uC77C\uBD80 \uB9C8\uB825 \uC7A5\uCE58\uC5D0\uC11C
      \uBD88\uADDC\uCE59\uD55C \uC5D0\uB108\uC9C0 \uBC29\uCD9C\uC774 \uAD00\uCE21\uB418\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    caution: 
    handoffMemo: 
  - day: 5
    recordType: "\uACE0\uC704\uD5D8 \uBC18\uC751 \uAE30\uB85D"
    title: "\uACE0\uC704\uD5D8 \uBC18\uC751"
    body: "\uC81C17 \uC81C\uC5B4\uC18C\uC5D0\uC11C \uD1B5\uC0C1 \uC218\uC900\uC744
      \uCD08\uACFC\uD558\uB294 \uACE0\uC704\uD5D8 \uB9C8\uB825 \uBC18\uC751\uC774
      \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uB9C8\uB825 \uADE0\uC5F4\uC758
      \uADDC\uBAA8\uC640 \uBD88\uC548\uC815\uC131\uC774 \uC99D\uAC00\uD558\uACE0
      \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC9C0\uC5ED \uC804\uCCB4\uC758 \uBE44\uC0C1 \uB300\uC751\uC774
      \uC9C0\uC18D\uB418\uACE0 \uC788\uC5B4 \uCD94\uAC00 \uD604\uC7A5 \uC778\uB825\uC758
      \uC989\uAC01\uC801\uC778 \uBC30\uCE58\uB294 \uC5B4\uB824\uC6B4 \uC0C1\uD669\uC785\uB2C8\uB2E4."
    caution: 
    handoffMemo: "\uB0AE\uC5D0 \uCC98\uC74C \uBCF4\uB294 \uADDC\uBAA8\uC758 \uADE0\uC5F4\uC774
      \uC0DD\uACBC\uC5B4.\n\uBCF4\uACE0\uB294 \uC62C\uB824\uB480\uB294\uB370, \uB2E4\uB978
      \uC81C\uC5B4\uC18C\uC5D0\uC11C\uB3C4 \uBE44\uC2B7\uD55C \uAC8C \uB098\uC654\uB300.\n\n\uC544\uBB34\uB798\uB3C4
      \uC774\uBC88 \uC8FC\uAE30\uAC00 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0 \uC9C0\uC6D0\uC744
      \uBC14\uB77C\uAE34 \uD798\uB4E4 \uAC83 \uAC19\uB2E4."
  - day: 6
    recordType: "\uC6B4\uC601 \uD604\uD669 \uAE30\uB85D"
    title: "\uD55C\uACC4\uC5D0 \uAC00\uAE4C\uC6B4 \uADFC\uBB34"
    body: "\uB9C8\uB825 \uBC94\uB78C\uC758 \uAC15\uB3C4\uAC00 \uB192\uC740 \uC218\uC900\uC744
      \uC720\uC9C0\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC81C17 \uC81C\uC5B4\uC18C\uC758
      \uC774\uC0C1\uD604\uC0C1 \uCC98\uB9AC \uBD80\uB2F4\uC774 \uC9C0\uC18D\uC801\uC73C\uB85C
      \uC99D\uAC00\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uD604\uC7AC \uC608\uCE21\uC5D0
      \uB530\uB974\uBA74 \uBC94\uB78C \uC885\uB8CC\uAE4C\uC9C0 \uC57D \uD558\uB8E8\uAC00
      \uB0A8\uC558\uC2B5\uB2C8\uB2E4.\n\n\uC2DC\uC124 \uC548\uC815\uD654 \uC5C5\uBB34\uB97C
      \uC720\uC9C0\uD558\uC2ED\uC2DC\uC624."
    caution: 
    handoffMemo: 
  - day: 7
    recordType: "\uCD5C\uC885 \uC6B4\uC601 \uAE30\uB85D"
    title: "\uB9C8\uC9C0\uB9C9 \uACE0\uBE44"
    body: "\uB9C8\uB825 \uBC94\uB78C\uC774 \uCD5C\uACE0 \uC218\uC900\uC5D0 \uB3C4\uB2EC\uD588\uC2B5\uB2C8\uB2E4.\n\n\uC81C17
      \uC81C\uC5B4\uC18C\uC758 \uACE0\uC704\uD5D8 \uC774\uC0C1\uD604\uC0C1 \uBC1C\uC0DD
      \uAC00\uB2A5\uC131\uC774 \uB9E4\uC6B0 \uB192\uC740 \uC0C1\uD0DC\uC785\uB2C8\uB2E4.\n\n\uBC94\uB78C
      \uC885\uB8CC \uC608\uC0C1 \uC2DC\uAC01\uC774 \uAC00\uAE4C\uC6CC\uC9C0\uACE0
      \uC788\uC73C\uB098, \uC885\uB8CC \uC9C1\uC804\uAE4C\uC9C0 \uB192\uC740 \uB9C8\uB825
      \uBC18\uC751\uC774 \uC9C0\uC18D\uB420 \uAC83\uC73C\uB85C \uC608\uC0C1\uB429\uB2C8\uB2E4.\n\n\uCD5C\uC885
      \uADFC\uBB34\uB97C \uAC1C\uC2DC\uD558\uC2ED\uC2DC\uC624."
    caution: 
    handoffMemo: 
